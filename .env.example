PORT=8080
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
AUDIO_STORAGE_BUCKET=songs

# Importer only (cmd/importer). The game server never reads these.
EXTERNAL_MUSIC_API_URL=https://api.deezer.com
EXTERNAL_MUSIC_API_KEY=
EXTERNAL_MUSIC_API_PROVIDER=deezer
# Set true ONLY if the provider's terms allow downloading and storing its audio.
EXTERNAL_MUSIC_ALLOW_AUDIO_DOWNLOAD=false

CORS_ORIGIN=http://localhost:5173
ROUND_SECONDS=10
REVEAL_SECONDS=8
MIN_PLAYERS=2
MAX_PLAYERS=12
